{
  "name": "ebusd-time-program-card",
  "version": "0.4.0",
  "description": "Home Assistant Lovelace card to edit Vaillant (ebusd ctlv2) weekly time programs for several days at once",
  "type": "module",
  "private": true,
  "license": "MIT",
  "funding": "https://github.com/sponsors/citoki",
  "scripts": {
    "dev": "vite dev --config vite.config.ts --port 5199 dev",
    "build": "vite build",
    "screenshot": "node scripts/screenshot.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "lit": "3.3.3"
  }
}
